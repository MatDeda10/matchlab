{
  "name": "matchlab",
  "version": "0.1.0",
  "private": true,
  "description": "MatchLab — football intelligence: analisi statistica trasparente, motore Poisson/Dixon-Coles, generatore di scenari e tracker di calibrazione.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "tsx scripts/db.ts migrate && tsx scripts/db.ts seed",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:status": "tsx scripts/db.ts status",
    "db:seed:real": "tsx scripts/db.ts seed-real",
    "data:snapshot": "tsx scripts/snapshot.ts",
    "sync": "tsx scripts/sync.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
