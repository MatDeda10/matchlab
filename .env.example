# MatchLab — variabili d'ambiente
# Copia in .env.local (sviluppo) o configura nel deployment.

# Provider dati:
#   demo               dataset sintetico (default)
#   football-data-uk   fonti gratuite senza chiave: football-data.co.uk + OpenFootball
#   football-data      football-data.org v4 (richiede chiave, opzionale)
DATA_PROVIDER=demo

# Quante stagioni storiche scaricare da football-data.co.uk (1–5, default 3).
# Le quote vengono importate solo per la stagione corrente.
FOOTBALL_DATA_UK_HISTORY_SEASONS=3

# Forza il download ignorando la cache HTTP di 6 ore.
FOOTBALL_DATA_UK_FORCE=0

# Bootstrap automatico dello snapshot incluso quando il DB è vuoto.
# Con DATA_PROVIDER=football-data-uk è attivo per default; 0 lo disattiva.
AUTO_SEED_REAL=
# Percorso alternativo dello snapshot (.json, .json.gz o .json.gz.b64).
REAL_SNAPSHOT_PATH=

# Chiave personale football-data.org v4 (solo con DATA_PROVIDER=football-data).
FOOTBALL_DATA_API_KEY=

# Competizioni football-data.org (codici separati da virgola).
# SA=Serie A, PL=Premier League, PD=LaLiga, BL1=Bundesliga, FL1=Ligue 1.
FOOTBALL_DATA_COMPETITIONS=SA,PL,PD,BL1,FL1

# Segreto per firmare il cookie di sessione. OBBLIGATORIO in produzione.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Percorso del database SQLite (default: ./data/matchlab.db).
DATABASE_PATH=

# Solo se vuoi mostrare una versione esplicita nel client.
NEXT_PUBLIC_APP_VERSION=0.1.0
